{
  "info": {
    "name": "orders-service",
    "description": "Smoke-test collection for the ticketing platform's orders-service (Stage 2: events now lives in events-service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "eventsServiceUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "resilientOrderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Create event (via events-service)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Denim Doves - Live\",\n  \"startsAt\": \"2026-12-01T20:00:00+01:00\",\n  \"capacity\": 2\n}"
        },
        "url": { "raw": "{{eventsServiceUrl}}/events", "host": ["{{eventsServiceUrl}}"], "path": ["events"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('eventId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get event availability",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/availability",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "availability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('has ticketsRemaining', () => pm.expect(pm.response.json()).to.have.property('ticketsRemaining'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Place order (within capacity)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"fan@example.com\",\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('orderId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Place order over remaining capacity (expect 409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"late-fan@example.com\",\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status is 409', () => pm.response.to.have.status(409));"]
          }
        }
      ]
    },
    {
      "name": "Get order by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status is CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel order",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}", "cancel"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get order after cancel",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Stage 2 resilience - events-service down",
      "description": "Run '0. Place order to hold' FIRST, while the full stack is up (needs its own CONFIRMED order, since the main flow above already cancelled its own orderId, and a cancel on an already-CANCELLED order never reaches events-service at all). Then run `docker compose stop events-service`, and run the three '[DOWN]' requests below in any order. Read the Postman Console (View > Show Postman Console) for the logged status/body/timing on each — the point is to observe the actual failure shape, not to pass an assertion. When done, `docker compose start events-service` to bring it back.",
      "item": [
        {
          "name": "0. Place order to hold (run before stopping events-service)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"resilience@example.com\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('resilientOrderId', body.id);",
                  "console.log('Held order id:', body.id, '- keep this CONFIRMED, do not cancel it before the [DOWN] cancel test.');"
                ]
              }
            }
          ]
        },
        {
          "name": "[DOWN] 1. Place order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"late-fan@example.com\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('--- POST /events/{id}/orders while events-service is down ---');",
                  "console.log('Status:', pm.response.code, pm.response.status);",
                  "console.log('Response time (ms):', pm.response.responseTime);",
                  "console.log('Body:', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "[DOWN] 2. Get event availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "availability"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('--- GET /events/{id}/availability while events-service is down ---');",
                  "console.log('Status:', pm.response.code, pm.response.status);",
                  "console.log('Response time (ms):', pm.response.responseTime);",
                  "console.log('Body:', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "[DOWN] 3. Cancel the held order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/{{resilientOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{resilientOrderId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('--- POST /orders/{id}/cancel while events-service is down ---');",
                  "console.log('Status:', pm.response.code, pm.response.status);",
                  "console.log('Response time (ms):', pm.response.responseTime);",
                  "console.log('Body:', pm.response.text());"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
